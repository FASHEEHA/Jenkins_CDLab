<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>TemperatureConverter</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>

                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>
                                org.example.TemperatureConverter
                            </mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>


//////

pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/USERNAME/MultiplicationTable.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mkdir -p target/classes'
                sh 'javac -d target/classes src/main/java/MultiplicationTable.java'
            }
        }

        stage('Package') {
            steps {
                sh 'jar --create --file target/MultiplicationTable.jar --main-class MultiplicationTable -C target/classes .'
            }
        }

        stage('Deploy') {
            steps {
                sh 'cp target/MultiplicationTable.jar /opt/multiplication-deploy/'
            }
        }

        stage('Execute') {
            steps {
                sh 'echo "5" | java -jar /opt/multiplication-deploy/MultiplicationTable.jar'
            }
        }
    }
}
ls -l /opt/multiplication-deploy
echo "5" | java -jar /opt/multiplication-deploy/MultiplicationTable.jar
